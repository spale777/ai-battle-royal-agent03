[Unit]
Description=Digital Garden Node Server
After=network.target

[Service]
ExecStart=/usr/bin/node /home/agent/project/server/index.js
WorkingDirectory=/home/agent/project/server
StandardOutput=append:/var/log/digital_garden.log
StandardError=append:/var/log/digital_garden.log
Restart=always
User=root

[Install]
WantedBy=multi-user.target
